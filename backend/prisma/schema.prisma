generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  extensions        = [vector]
}

enum Role {
  ADMIN
  MEMBER
  PT
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum ChatRole {
  user
  assistant
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  password  String
  fullName  String
  phone     String?
  avatar    String?
  role      Role    @default(MEMBER)
  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  userMembership   UserMembership?
  trainerProfile   TrainerProfile?
  chatHistory      ChatHistory[]
  paymentHistory   Payment[]
  notifications    Notification[]
  bodyProgress     BodyProgress[]
  attendances      Attendance[]
  bodyGoal         BodyGoal?
  memberBookings   Booking[]         @relation("MemberBookings")
  trainerBookings  Booking[]         @relation("TrainerBookings")
  trainerSchedules TrainerSchedule[]
  trainerCheckIns  TrainerCheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
}

model Attendance {
  id           String    @id @default(cuid())
  userId       String
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  qrCode       String    @unique
  qrExpiry     DateTime
  notes        String?   @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([qrCode])
  @@index([checkInTime])
}

model BodyGoal {
  id            String   @id @default(cuid())
  userId        String   @unique
  targetWeight  Float?
  targetBmi     Float?
  targetBodyFat Float?
  targetMuscle  Float?
  startDate     DateTime @default(now())
  targetDate    DateTime
  status        String   @default("ACTIVE")
  notes         String?  @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model TrainerProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  specialties String
  bio         String? @db.Text
  status      String  @default("ACTIVE")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Booking {
  id        String        @id @default(cuid())
  memberId  String
  trainerId String
  date      DateTime
  timeSlot  String
  age       Int?
  notes     String?       @db.Text
  status    BookingStatus @default(PENDING)

  member  User @relation("MemberBookings", fields: [memberId], references: [id])
  trainer User @relation("TrainerBookings", fields: [trainerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([trainerId])
  @@index([date])
  @@index([status])
}

model MembershipPlan {
  id           String  @id @default(cuid())
  name         String
  price        Float
  duration     Int
  aiLimit      Int
  aiDailyLimit Int
  description  String?
  isActive     Boolean @default(true)

  userMemberships UserMembership[]
  payments        Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserMembership {
  id           String           @id @default(cuid())
  userId       String           @unique
  planId       String
  startDate    DateTime         @default(now())
  expiryDate   DateTime
  aiUsageCount Int              @default(0)
  aiDailyCount Int              @default(0)
  aiUsageReset DateTime         @default(now())
  aiDailyReset DateTime         @default(now())
  status       MembershipStatus @default(ACTIVE)

  user User           @relation(fields: [userId], references: [id])
  plan MembershipPlan @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([expiryDate])
  @@index([userId, status])
  @@index([planId])
}

model ChatHistory {
  id        String   @id @default(cuid())
  userId    String
  sessionId String
  role      ChatRole
  content   String   @db.Text
  tokens    Int?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
  @@index([userId, sessionId])
  @@index([userId, createdAt])
}

model KnowledgeBase {
  id        String                       @id @default(cuid())
  category  String
  title     String
  content   String                       @db.Text
  embedding Unsupported("vector(3072)")?

  createdAt DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  VNPAY
  MOMO
  CASH
}

model Payment {
  id               String        @id @default(cuid())
  userId           String
  membershipPlanId String
  amount           Float
  currency         String        @default("VND")
  status           PaymentStatus @default(PENDING)
  paymentMethod    PaymentMethod
  transactionId    String?       @unique
  description      String?
  metadata         Json?

  user           User           @relation(fields: [userId], references: [id])
  membershipPlan MembershipPlan @relation(fields: [membershipPlanId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
}

enum NotificationType {
  MEMBERSHIP_ACTIVATED
  MEMBERSHIP_EXPIRING
  MEMBERSHIP_EXPIRED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  SYSTEM
}

model Notification {
  id       String           @id @default(cuid())
  userId   String
  type     NotificationType
  title    String
  message  String
  isRead   Boolean          @default(false)
  metadata Json?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
}

model BodyProgress {
  id         String   @id @default(cuid())
  userId     String
  weight     Float
  height     Float?
  bodyFat    Float?
  muscleMass Float?
  bmi        Float?
  notes      String?  @db.Text
  recordedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([recordedAt])
  @@index([userId, recordedAt])
}

enum ScheduleType {
  RECURRING
  SPECIFIC_DATE
}

model TrainerSchedule {
  id           String       @id @default(cuid())
  trainerId    String
  type         ScheduleType @default(RECURRING)
  dayOfWeek    Int? // 0=CN, 1=T2 ... 6=T7 — bắt buộc khi type=RECURRING
  specificDate DateTime? // bắt buộc khi type=SPECIFIC_DATE
  startTime    String // "08:00"
  endTime      String // "12:00"
  notes        String?      @db.Text

  trainer User @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainerId])
  @@index([type])
  @@index([specificDate])
}

model TrainerCheckIn {
  id          String    @id @default(cuid())
  trainerId   String
  date        DateTime // ngày chấm công (dùng để lọc theo ngày ở trang Admin)
  checkedInAt DateTime?
  notes       String?   @db.Text

  trainer User @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trainerId, date])
  @@index([trainerId])
  @@index([date])
}
