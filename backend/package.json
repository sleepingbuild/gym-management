{
    "name": "backend",
    "version": "0.1.0",
    "description": "IronFit Pro Gym Management Backend",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev --respawn src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "lint": "eslint \"src/**/*.{js,ts}\"",
        "format": "prettier --write .",
        "seed": "tsx prisma/seed.ts",
        "seed:knowledge": "tsx prisma/seed-knowledge.ts",
        "test": "jest --runInBand --forceExit",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage --forceExit",
        "test:ci": "jest --runInBand --coverage --forceExit"
    },
    "keywords": [
        "gym",
        "management",
        "fitness"
    ],
    "author": "IronFit Team",
    "license": "MIT",
    "type": "commonjs",
    "dependencies": {
        "@google/genai": "^2.8.0",
        "@google/generative-ai": "^0.24.1",
        "@prisma/client": "^6.19.3",
        "axios": "^1.17.0",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^7.5.0",
        "helmet": "^8.2.0",
        "ioredis": "^5.11.1",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.10.1",
        "pg": "^8.22.0",
        "prisma": "^6.19.3",
        "qs": "^6.15.2",
        "redis": "^6.1.0",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^14.0.0",
        "winston": "^3.19.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-serve-static-core": "^5.0.6",
        "@types/ioredis": "^4.28.10",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/node": "^25.9.4",
        "@types/pg": "^8.20.0",
        "@types/qs": "^6.15.1",
        "@types/supertest": "^7.2.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/uuid": "^10.0.0",
        "@types/winston": "^2.4.4",
        "@typescript-eslint/eslint-plugin": "^8.60.0",
        "@typescript-eslint/parser": "^8.60.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "jest": "^30.4.2",
        "prettier": "^3.8.3",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.11",
        "ts-node-dev": "^2.0.0",
        "tsx": "^4.22.3",
        "typescript": "^6.0.3"
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    }
}
